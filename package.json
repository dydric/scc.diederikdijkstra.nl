{
  "name": "scc.diederikdijkstra.nl",
  "private": true,
  "version": "2025.01.03",
  "type": "module",
  "scripts": {
    "clean": "rm -rf _site",
    "clean-cache": "rm -rf _site .cache",
    "w:11ty": "eleventy --serve",
    "b:11ty": "eleventy",
    "w:tw": "tailwindcss -i src/css/tw/tw.css -o _site/css/tw.css --watch",
    "b:tw": "tailwindcss -i src/css/tw/tw.css -o _site/css/tw.css --minify",
    "w:js": "esbuild src/js/core.js 'src/js/pages/*.js' 'src/js/components/*.js' --outbase=src/js --outdir=_site/js --bundle --splitting --format=esm --chunk-names=chunks/[name]-[hash] --watch",
    "b:js": "esbuild src/js/core.js 'src/js/pages/*.js' 'src/js/components/*.js' --outbase=src/js --outdir=_site/js --bundle --splitting --format=esm --chunk-names=chunks/[name]-[hash] --minify",
    "watch": "cross-env NODE_ENV=development npm-run-all --parallel w:* ",
    "dev": "npx netlify dev",
    "build": "cross-env NODE_ENV=production npm-run-all clean --parallel b:tw b:js --sequential b:11ty",
    "scc:matchdata": "node --env-file=.env tools/scripts/scc-matchdata.mjs",
    "scc:upcoming": "node tools/scripts/scc-upcoming.mjs",
    "check:build": "node tools/scripts/check-build.mjs",
    "test": "node --test tools/tests/*.test.mjs"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.0.0",
    "netlify-cli": "^23.15.1"
  },
  "dependencies": {
    "@netlify/blobs": "^10.5.0",
    "@tailwindcss/cli": "^4.1.18",
    "cross-env": "^7.0.3",
    "esbuild": "^0.24.0",
    "html-minifier-terser": "^7.2.0",
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^4.1.18"
  }
}
